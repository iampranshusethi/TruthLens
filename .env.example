# Copy this file to .env.local and fill in at least one key. Never commit .env.local.

# Google AI Studio (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: model ids to try in order, comma-separated (default gemini-3.6-flash,gemini-3.5-flash,gemini-flash-lite-latest,gemini-3.8-flash; the last one is tried after Groq)
# and a thinking level for Gemini 3 models (default low)
GEMINI_MODEL=
GEMINI_THINKING_LEVEL=

# Groq (free tier, used if Gemini fails): https://console.groq.com/keys
GROQ_API_KEY=
# Optional: model id (default openai/gpt-oss-120b)
GROQ_MODEL=

# Without any key, development uses an offline demo engine; production shows "switched off".

# Supabase (free tier) for Google sign-in and cloud history. Leave empty to keep history browser-only.
# Project settings → API: the project URL and the publishable (anon) key. Both are safe to expose to browsers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional, local development only: an HTTP proxy for outbound AI calls (e.g. a campus network).
DEV_PROXY=

# Google sign-in button (Google Identity Services). The OAuth client ID from Google Cloud Console; public by design.
# Without it, sign-in falls back to Supabase's redirect page.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Usage stats (/stats). Server-only: never prefix these with NEXT_PUBLIC_.
# Supabase → Project Settings → API Keys → Secret keys. Lets the server record anonymous usage events.
SUPABASE_SECRET_KEY=
# Who may open /stats: the Google account email(s) you sign in with, comma-separated.
STATS_ADMIN_EMAIL=
