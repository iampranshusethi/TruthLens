# Copy this file to .env.local and fill in at least one key. Never commit .env.local.

# Google AI Studio (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: model id (default gemini-flash-latest) and thinking level for models that support it (e.g. low)
GEMINI_MODEL=
GEMINI_THINKING_LEVEL=

# Groq (free tier, used if Gemini fails): https://console.groq.com/keys
GROQ_API_KEY=
# Optional: model id (default llama-3.3-70b-versatile)
GROQ_MODEL=

# Without any key, development uses an offline demo engine; production shows "switched off".
